# Copy to .env and fill in. Never commit .env.

# LLM provider. The app talks to an OpenAI-compatible API; here that is OpenRouter.
# To use OpenAI directly instead, drop OPENAI_BASE_URL and use an OpenAI key and model id.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Model used to generate cards, as "provider/model" (see openrouter.ai/models).
CARD_MODEL=

# Reasoning models are slow and costly per card. "off" is the recommended setting;
# "low", "medium" or "high" set the effort; empty uses the model default.
# Some models (e.g. z-ai/glm-5.3-flash) reject "off".
CARD_REASONING=off

# Shared secret for routes that spend API credit. Required in production;
# in development an empty value allows all requests. Send it as the x-access-code header.
ACCESS_CODE=

# Card format spec (personal, kept out of git). Optional locally: when both are
# empty the app reads docs/skills/anki-chinese-flashcard/SKILL.md.
# On a deployment set CARD_SPEC to the spec text, or CARD_SPEC_FILE to a path.
CARD_SPEC=
CARD_SPEC_FILE=
